# Copy to .env for local development. Never commit a real key (.env is gitignored).

# Required — your Anthropic API key. Held server-side only.
ANTHROPIC_API_KEY=sk-ant-...

# Optional — override the models without a frontend redeploy.
# ANTHROPIC_MODEL_CHAT=claude-haiku-4-5-20251001
# ANTHROPIC_MODEL_DRAFT=claude-sonnet-4-6

# Optional — server port (defaults to 3001 locally; App Platform sets PORT).
# PORT=3001
